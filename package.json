{
  "name": "dsh-codex-memory",
  "version": "1.0.0",
  "description": "Codex's V2 memory pipeline for DeepSeek Harness: two-stage extraction, SQLite job table with lease and retry, git baseline diff gating, citation feedback.",
  "license": "Apache-2.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rocco623/dsh-codex-memory.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "memory"
  ],
  "engines": {
    "node": ">=24.21.0"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "config.js",
    "pipeline.js",
    "model.js",
    "rollout-input.js",
    "sources.js",
    "memory-backend.js",
    "private-workspace-tools.js",
    "db.js",
    "workspace.js",
    "storage.js",
    "sessions.js",
    "zstd.js",
    "prompts.js",
    "redact.js",
    "citations.js",
    "templates/**",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "NOTICE"
  ],
  "scripts": {
    "test": "node selftest.mjs",
    "check": "node check.mjs",
    "verify:prompts": "node verify-prompts.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-format": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-format-v3-to-v4": "0.2.1-rc.3"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  }
}
